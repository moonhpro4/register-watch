{
  "expo": {
    "name": "Register Watch",
    "slug": "register-watch",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.registerwatch.app",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
